{
  "name": "meanwhile-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Meanwhile, a shared weekly newspaper for friends.",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project ai && pnpm --dir frontend test",
    "test:watch": "vitest --project unit --project ai",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "openapi": "node --import tsx scripts/generate-openapi.ts",
    "openapi:check": "node --import tsx scripts/generate-openapi.ts --check",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm openapi:check && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
