# Weather for the front page. Set ONE of these (server-side only, never sent to the browser).
# SearchApi: https://www.searchapi.io  →  dashboard → API key
SEARCHAPI_KEY=
# or SerpApi: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Comic and avatar generation (server/). Server-side only, never sent to the browser.
# Put these in .env.local. Get a key from Meta's developer dashboard.
META_API_KEY=
# Optional overrides:
# META_BASE_URL=https://api.meta.ai/v1
# META_IMAGE_MODEL=muse-image-1.0
# META_TEXT_MODEL=muse-spark-1.1
# META_AVATAR_SIZE=1024x1024
# META_PANEL_SIZE=1536x1024
