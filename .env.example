# Copy to .env.local and fill in. Never commit real values.
# Local Supabase values are printed by `pnpm supabase status` after `pnpm db:start`.

APP_ENV=local
LOG_LEVEL=info

# Supabase. The iOS app only ever gets SUPABASE_URL and SUPABASE_ANON_KEY.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# Server only. Bypasses row-level security, so every route using it checks auth and membership itself.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Shared secret for cron-only routes (at least 32 chars). Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-at-least-32-random-characters

# AI provider selection: stub | real
AI_PROVIDER=stub
# Moderation provider selection: stub | real (stub is rejected when APP_ENV=production)
MODERATION_PROVIDER=stub
# Required only when AI_PROVIDER=real. Use separate keys per environment, with spend limits set at the provider.
AI_REAL_API_KEY=
AI_REAL_BASE_URL=
AI_REAL_TEXT_MODEL=
AI_REAL_IMAGE_MODEL=
# Required only when MODERATION_PROVIDER=real.
MODERATION_REAL_API_KEY=
# AI cost and abuse limits
AI_TIMEOUT_MS=30000
AI_MAX_CONCURRENCY=4
AI_USER_DAILY_TEXT_CALLS=40
AI_USER_DAILY_IMAGE_CALLS=20
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=60000

# Secret mixed into invite code hashes (at least 32 chars). Generate with: openssl rand -hex 32
INVITE_CODE_PEPPER=replace-with-at-least-32-random-characters

# Browser origins allowed to call the API (the web app), comma-separated, exact match, no paths.
# Example for local dev: http://localhost:3000. Production origins must use https.
CORS_ALLOWED_ORIGINS=

# Request rate limits. Store: postgres (shared across instances) | memory (single process only)
RATE_LIMIT_STORE=postgres
RATE_LIMIT_USER_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=120
# Multiplies per-route limits. Leave at 1; the integration tests raise it. Must be 1 in production.
RATE_LIMIT_ROUTE_SCALE=1

# Retention
# Sliding window for draft posts, extended by activity.
RETENTION_WINDOW_DAYS=30
# After logout, draft posts are hidden immediately and purged after this many hours unless the user signs back in.
RETENTION_LOGOUT_GRACE_HOURS=24
# Posts in a published edition are deleted this many days after that edition was published.
RETENTION_PUBLISHED_DAYS=30
# Selfies are deleted when the avatar is approved, or after this many minutes at most.
SELFIE_MAX_AGE_MINUTES=60

# Signed URL lifetime for images in the edition bundle.
SIGNED_URL_TTL_SECONDS=600

# Tests only: set to true to run live-provider smoke tests.
AI_LIVE_TESTS=false
